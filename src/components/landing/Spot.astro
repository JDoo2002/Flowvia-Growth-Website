---
interface Props { class?: string; n: string; title: string; description: string; }
const { class: className = '', n, title, description } = Astro.props;
---
<article data-spot class:list={['reveal group relative overflow-hidden rounded-[2rem] border border-border bg-card p-8 transition-colors duration-500 hover:border-accent/40', className]}>
  <div class="spotlight pointer-events-none absolute inset-0 opacity-0 transition-opacity duration-500 group-hover:opacity-100" aria-hidden="true"></div>
  <div class="relative h-full"><span class="text-xs tabular-nums text-accent">{n}</span><h3 class="font-display mt-3 text-4xl">{title}</h3><p class="mt-3 max-w-sm text-muted-foreground">{description}</p><slot /></div>
</article>
