---
import Brand from '../components/Brand.astro';
import Icon from '../components/Icon.astro';
import { benefits, bookingUrl, faqs, process } from '../data/site';
import conversation from '../data/conversation.json';
import schema from '../data/schema.json';
import '../styles/global.css';
const before = [
  { who: 'user', text: 'Hi, I’d like a quote for solar and a battery.' },
  { who: 'ai', text: 'Hi! Thanks for your enquiry. Do you own the home?', label: 'Replied in 2 hrs' },
  { who: 'user', text: 'Yes, I own it.' },
  { who: 'ai', text: 'Great. Roughly what’s your power bill each quarter?', label: 'Replied in 4 hrs' },
];
const appointment = [
  ['Property', 'Homeowner'], ['Roof', 'Colorbond · Mostly clear'],
  ['Existing solar', '6.6 kW · Sungrow inverter'], ['Quarterly bill', '$600'],
  ['Energy needs', 'Ducted AC · Future EV'], ['Battery location', 'Garage side wall · To assess'],
  ['Appointment', 'Wednesday · 10:00 AM · On-site assessment'],
];
---
<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Flowvia Growth | Solar &amp; Battery Business Growth</title>
    <meta name="description" content="A done-for-you lead system. Serious homeowners, booked into your calendar, without relying on referrals or chasing dead leads. All you have to do is show up and install." />
    <meta name="author" content="Ethan Nguyen" />
    <meta name="theme-color" content="#123b32" />
    <meta property="og:title" content="Flowvia Growth" />
    <meta property="og:description" content="A done-for-you lead system for solar and battery installation business owners." />
    <meta property="og:type" content="website" />
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preload" href="/fonts/manrope-variable.ttf" as="font" type="font/ttf" crossorigin />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header" id="top">
      <div class="container header-inner">
        <Brand />
        <nav class="desktop-nav" aria-label="Main navigation"><a href="#the-system">The system</a><a href="#how-it-works">How it works</a><a href="#faq">FAQ</a></nav>
        <a class="button button-small header-cta" href={bookingUrl}>Book a strategy call <Icon name="diagonal" size={17} /></a>
        <button class="menu-toggle" type="button" aria-label="Open navigation" aria-controls="mobile-navigation" aria-expanded="false"><Icon name="menu" /></button>
      </div>
      <nav class="mobile-nav container" id="mobile-navigation" aria-label="Mobile navigation" hidden><a href="#the-system">The system <Icon name="arrow" size={18} /></a><a href="#how-it-works">How it works <Icon name="arrow" size={18} /></a><a href="#faq">FAQ <Icon name="arrow" size={18} /></a><a href={bookingUrl}>Book a strategy call <Icon name="diagonal" size={18} /></a></nav>
    </header>
    <main id="main">
      <section class="hero" aria-labelledby="hero-title">
        <div class="container hero-grid">
          <div class="hero-copy">
            <p class="eyebrow audience"><span class="status-dot"></span> For solar and battery installation business owners</p>
            <h1 id="hero-title">Wake up to <span class="text-green">booked out</span> installation appointments,<br class="desktop-break" /> <span class="muted-title">not missed leads.</span></h1>
            <p class="hero-description">A done-for-you lead system. Serious homeowners, booked into your calendar, without relying on referrals or chasing dead leads. All you have to do is show up and install.</p>
            <a class="button hero-button" href={bookingUrl}>Book a strategy call here <span class="button-icon"><Icon name="diagonal" size={19} /></span></a>
            <div class="hero-note"><span><Icon name="check" size={15} /> 45-Minute Strategy Call</span><span><Icon name="check" size={15} /> 90-Day Growth Plan</span></div>
          </div>
          <div class="hero-visual">
            <div class="photo-frame"><img class="hero-photo" src="/images/solar-roof.jpg" width="1400" height="788" alt="Solar panels on a residential rooftop surrounded by greenery" fetchpriority="high" /><div class="photo-shade"></div><div class="photo-label"><Icon name="sun" size={19} /> Solar &amp; battery. Smarter growth.</div><span class="visual-corner" aria-hidden="true"><Icon name="diagonal" size={28} /></span></div>
            <div class="assistant-tag"><span class="assistant-icon"><Icon name="bolt" size={18} /></span><div><strong>Solar &amp; Battery Assistant</strong><span><i class="status-dot"></i> Replies in seconds, 24/7</span></div></div>
            <div class="booking-notification"><span class="notification-icon"><Icon name="calendar" size={24} /></span><div><span class="notification-label">Book the Install Appointments</span><strong>Appointment booked <Icon name="check" size={16} /></strong><p>Wednesday · 10:00 AM</p></div><span class="notification-check"><Icon name="check" size={15} /></span></div>
            <span class="visual-caption">Our Lead Process <span aria-hidden="true">↗</span></span>
          </div>
        </div>
        <div class="container benefits">{benefits.map(benefit => <div class="benefit"><div class="benefit-icon"><Icon name={benefit.icon} size={23} /></div><div><p class="benefit-label">{benefit.label}</p><h2>{benefit.title}</h2><p>{benefit.description}</p></div></div>)}</div>
      </section>
      <section class="system-section section-space" id="the-system" aria-labelledby="system-title">
        <div class="container">
          <div class="system-heading"><span class="section-index">01 / THE OPPORTUNITY</span><p>What are the top 3% performing solar and battery installation business owners doing?</p></div>
          <div class="system-grid">
            <div><h2 id="system-title">They don’t just<br /> chase more leads.<br /><span>They close the ones<br /> they already have.</span></h2><div class="system-signoff"><span class="circle-arrow"><Icon name="diagonal" size={22} /></span><p>No lead left behind.<br />No sale left on the table.</p></div></div>
            <div class="system-detail"><p class="system-detail-label">When busy staff handle follow-up:</p><ul class="pain-list"><li><span>01</span>Leads slip through the cracks<Icon name="cross" size={17} /></li><li><span>02</span>Prospects go cold<Icon name="cross" size={17} /></li><li><span>03</span>Revenue walks out the door<Icon name="cross" size={17} /></li></ul><p class="system-description">After being burned by tools that overpromised and underdelivered, smart operators are switching to systems that follow up with every lead, every time.</p></div>
          </div>
        </div>
      </section>
      <section class="ceiling-section section-space" aria-labelledby="ceiling-title">
        <div class="container ceiling-grid"><div><p class="eyebrow"><span class="tiny-line"></span> A more reliable pipeline</p><h2 id="ceiling-title">Stop relying on<br /> word of mouth.<br />Start scaling <span class="text-green">consistently.</span></h2></div><div class="ceiling-copy"><p class="lead-paragraph">Most solar businesses hit a ceiling, and it’s not from lack of effort.</p><p>Work comes from word of mouth, which you can’t control. You pay for leads that may never turn into jobs. And when the market slows or government rebate changes, enquiries dry up overnight.</p><p class="ceiling-result">The result? Busy months followed by quiet ones, and a pipeline you can never rely on.</p></div></div>
      </section>
      <section class="process-section section-space" id="how-it-works" aria-labelledby="process-title">
        <div class="container process-grid"><div class="process-intro"><span class="section-index">02 / OUR LEAD PROCESS</span><h2 id="process-title">How our system turns clicks into <span class="text-green">booked jobs</span></h2><div class="process-symbol" aria-hidden="true"><Icon name="sun" size={44} /><span></span><Icon name="calendar" size={44} /></div><a class="text-link" href={bookingUrl}>Book a strategy call <Icon name="diagonal" size={20} /></a></div><ol class="process-list">{process.map((step, i) => <li><div class="step-marker"><Icon name={step.icon} size={24} /></div><div class="step-copy"><span class="step-number">STEP {String(i + 1).padStart(2, '0')}</span><h3>{step.title}</h3><p>{step.description}</p></div></li>)}</ol></div>
      </section>
      <section class="comparison-section section-space" id="before-after" aria-labelledby="comparison-title">
        <div class="container">
          <div class="comparison-heading"><div><span class="section-index">03 / SEE THE DIFFERENCE</span><h2 id="comparison-title">No lead left behind.<br /><span class="text-green">No sale left on the table.</span></h2></div><p>Illustrative conversations<br /><span>Same enquiry. A different follow-up.</span></p></div>
          <div class="comparison-grid">
            <article class="chat-example before-example"><div class="comparison-label"><h3>Before</h3><span>having a reliable pipeline</span><Icon name="cross" size={20} /></div><div class="chat-panel"><div class="chat-header"><span class="chat-avatar">SI</span><div><strong>Solar Installer · Manual Follow-Up</strong><span>Left on seen</span></div><span class="chat-status offline"></span></div><div class="chat-messages" tabindex="0" role="region" aria-label="Before: manual follow-up conversation">{before.map((message, i) => <>{i === 1 && <p class="time-gap"><Icon name="clock" size={12} /> 2 hours later</p>}{i === 3 && <p class="time-gap"><Icon name="clock" size={12} /> 4 hours later</p>}<div class:list={['chat-bubble', message.who]}><p>{message.text}</p>{message.label && <span class="message-time">{message.label}</span>}</div></>)}<p class="seen-label">✓✓ Seen</p><p class="time-gap">No reply from customer</p></div><div class="outcome outcome-before"><div class="outcome-title"><Icon name="cross" size={18} /><strong>No appointment booked</strong></div><dl class="outcome-grid"><div><dt>First reply</dt><dd>2 hours</dd></div><div><dt>Second reply</dt><dd>4 hours later</dd></div><div class="full-width"><dt>Installer’s last message</dt><dd>Left on seen</dd></div></dl><div class="outcome-revenue"><span>Revenue lost<br />on average per job</span><strong>−$8,000</strong></div></div></div></article>
            <article class="chat-example after-example"><div class="comparison-label"><h3>After</h3><span>having a reliable pipeline</span><Icon name="check" size={22} /></div><div class="chat-panel"><div class="chat-header"><span class="chat-avatar ai-avatar">AI</span><div><strong>Solar &amp; Battery Assistant</strong><span>AI assistant · Replies in seconds, 24/7</span></div><span class="chat-status"></span></div><div class="chat-messages" tabindex="0" role="region" aria-label="After: automated follow-up conversation, scroll to read all messages">{conversation.map(message => <div class:list={['chat-bubble', message.who]}><p>{message.text}</p>{message.label && <span class="message-time">{message.label}</span>}</div>)}</div><div class="outcome outcome-after"><div class="outcome-title"><Icon name="check" size={19} /><strong>Appointment booked · Wednesday 10:00 AM</strong></div><details class="appointment-details"><summary>Appointment details <Icon name="plus" size={16} /></summary><dl class="outcome-grid">{appointment.map(([label, value]) => <div class:list={{ 'full-width': label === 'Appointment' }}><dt>{label}</dt><dd>{value}</dd></div>)}</dl></details><div class="outcome-revenue"><span>Potential revenue gained<br />per completed job</span><strong>+~$8,000</strong></div></div></div></article>
          </div>
          <div class="lead-loss"><div class="lead-loss-icon"><Icon name="bolt" size={28} /></div><div><h2>Every lead you lose is a lost sale that goes to someone else who replied first</h2><p>If you're a business owner earning less than $2 million dollar revenue per year and if getting qualified leads isn’t your problem, speed to respond is, because the first one to reply usually wins the job.</p><strong>That’s the leak we plug.</strong></div></div>
        </div>
      </section>
      <section class="faq-section section-space" id="faq" aria-labelledby="faq-title"><div class="container faq-grid"><div class="faq-intro"><span class="section-index">04 / FAQ</span><h2 id="faq-title">Commonly asked Questions you may have</h2><p>Quick answers before you book a call.</p><a class="text-link" href={bookingUrl}>Book a strategy call <Icon name="diagonal" size={20} /></a></div><div class="faq-list">{faqs.map((faq, i) => <details name="faqs" open={i === 0}><summary>{faq.question}<span class="faq-plus"><Icon name="plus" size={19} /></span></summary><div class="faq-answer"><p>{faq.answer}</p></div></details>)}</div></div></section>
      <section class="final-section" aria-labelledby="final-title"><div class="container"><div class="final-panel"><div class="final-orbit" aria-hidden="true"></div><p class="eyebrow"><span class="status-dot"></span> We make running your business smoother through smart systems that drive growth.</p><h2 id="final-title">Are you ready to scale your business to make over <span>100k within 90 days?</span></h2><a class="button" href={bookingUrl}>Book a strategy call here <span class="button-icon"><Icon name="diagonal" size={20} /></span></a><p class="final-note">Don't chase leads, chase smarter oppotunities</p></div></div></section>
    </main>
    <footer class="site-footer"><div class="container footer-main"><Brand footer /><a class="footer-email" href="mailto:flowviagrowth@gmail.com"><Icon name="mail" size={18} />flowviagrowth@gmail.com<Icon name="diagonal" size={16} /></a><span class="footer-location"><span class="status-dot"></span> Australia</span></div><div class="container footer-bottom"><span>2026 Flowvia Growth All Rights Reserved</span><a href="#top">Back to top <Icon name="diagonal" size={15} /></a></div></footer>
    <script>
      const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
      const navigation = document.querySelector<HTMLElement>('#mobile-navigation');
      function closeNavigation() {
        if (!toggle || !navigation) return;
        toggle.setAttribute('aria-expanded', 'false');
        toggle.setAttribute('aria-label', 'Open navigation');
        navigation.hidden = true;
      }
      toggle?.addEventListener('click', () => {
        if (!navigation) return;
        const open = toggle.getAttribute('aria-expanded') !== 'true';
        toggle.setAttribute('aria-expanded', String(open));
        toggle.setAttribute('aria-label', open ? 'Close navigation' : 'Open navigation');
        navigation.hidden = !open;
      });
      navigation?.querySelectorAll('a').forEach(link => link.addEventListener('click', closeNavigation));
      document.addEventListener('keydown', event => {
        if (event.key === 'Escape' && toggle?.getAttribute('aria-expanded') === 'true') { closeNavigation(); toggle.focus(); }
      });
      window.matchMedia('(min-width: 901px)').addEventListener('change', event => { if (event.matches) closeNavigation(); });
    </script>
  </body>
</html>
