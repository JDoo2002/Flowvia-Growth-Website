---
import { Image } from 'astro:assets';
import Brand from '../components/Brand.astro';
import BookButton from '../components/landing/BookButton.astro';
import LiveChat from '../components/landing/LiveChat.astro';
import Spot from '../components/landing/Spot.astro';
import hero from '../assets/reference-hero.jpg';
import { bookingUrl, faqs } from '../data/site';
import schema from '../data/schema.json';
import '../styles/global.css';

const features = ['Replies in seconds', 'Qualifies homeowner enquiries', 'Books site assessments', 'Follow-up, 24/7', 'Built for solar & battery', '90-day roadmap', 'Set up and managed for you'];
const objections = [
  ['Word of mouth', 'Hard to predict.'],
  ['Buying leads', 'Still needs follow-up.'],
  ['Changing rebates', 'Demand can shift.'],
];
const race = [
  { who: 'Manual follow-up', time: '4 hrs+', end: 'No reply · The enquiry goes cold', width: '100%', duration: '4s', bad: true },
  { who: 'With Flowvia Growth', time: '2 sec', end: 'Assessment booked · Thursday 10am', width: '4%', duration: '0.4s', bad: false },
];
---
<!doctype html>
<html lang="en-AU" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Flowvia Growth | More Booked Solar &amp; Battery Jobs</title>
    <meta name="description" content="Done-for-you advertising, AI lead qualification and follow-up, and appointment booking for Australian solar and battery installers. 90-day roadmap. No lock-in." />
    <meta name="theme-color" content="#04060b" />
    <meta property="og:title" content="Flowvia Growth | Wake up to booked-out installation appointments" />
    <meta property="og:description" content="Targeted ads, an AI assistant and appointments in your calendar. We build and manage the whole system for your business." />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preload" href="/fonts/geist-variable.ttf" as="font" type="font/ttf" crossorigin />
    <link rel="preload" href="/fonts/instrument-serif-regular.ttf" as="font" type="font/ttf" crossorigin />
  </head>
  <body id="top" class="grain overflow-x-clip">
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="fixed inset-x-0 top-4 z-50 flex justify-center px-4">
      <div class="floating-nav glass flex items-center gap-8 rounded-full border border-border py-2 pl-5 pr-2 transition-all duration-500" data-nav>
        <Brand />
        <nav class="hidden gap-6 text-sm text-muted-foreground md:flex" aria-label="Main navigation">
          <a href="#system" class="transition-colors hover:text-foreground">System</a>
          <a href="#race" class="transition-colors hover:text-foreground">The difference</a>
          <a href="#faq" class="transition-colors hover:text-foreground">FAQ</a>
        </nav>
        <a href={bookingUrl} class="rounded-full bg-primary px-4 py-2 text-xs font-medium text-primary-foreground transition-opacity hover:opacity-90">Book a call</a>
      </div>
    </header>
    <main id="main">
      <section class="hero relative flex min-h-[100svh] items-center overflow-hidden px-6 pb-20 pt-32" aria-labelledby="hero-title" data-hero>
        <div class="absolute inset-0" data-hero-parallax aria-hidden="true">
          <Image src={hero} alt="" width={1920} height={1088} widths={[640, 960, 1440, 1920]} sizes="100vw" loading="eager" fetchpriority="high" class="hero-photo animate-kenburns h-full w-full object-cover" />
        </div>
        <div class="absolute inset-0 bg-gradient-to-r from-background via-background/85 to-background/20" aria-hidden="true"></div>
        <div class="absolute inset-0 bg-gradient-to-t from-background via-transparent to-background/40" aria-hidden="true"></div>
        <div class="relative mx-auto grid w-full max-w-7xl items-center gap-16 lg:grid-cols-[1.3fr_1fr]">
          <div>
            <p class="animate-rise mb-8 inline-flex items-center gap-2 rounded-full border border-border bg-background/40 px-3 py-1 text-xs text-muted-foreground backdrop-blur">
              <span class="h-1.5 w-1.5 rounded-full bg-accent" aria-hidden="true"></span> Built for solar &amp; battery installers
            </p>
            <h1 id="hero-title" class="hero-title animate-rise font-display" style="animation-delay:100ms">
              Wake up to<br /> booked-out<br /> installation<br /> appointments,<br /> <em class="text-sun">not missed leads.</em>
            </h1>
            <p class="animate-rise mt-8 max-w-md text-lg text-muted-foreground" style="animation-delay:250ms">We run your ads. Your AI assistant follows up in seconds and books qualified homeowners into your calendar. A complete lead and appointment system, built and managed for your business.</p>
            <div class="animate-rise mt-10 flex flex-wrap items-center gap-6" style="animation-delay:400ms">
              <BookButton />
              <span class="text-sm text-muted-foreground">No lock-in · Done for you</span>
            </div>
          </div>
          <div class="animate-rise flex justify-center pb-6 lg:justify-end" style="animation-delay:550ms"><LiveChat /></div>
        </div>
      </section>

      <div class="marquee relative overflow-hidden border-y border-border py-6" aria-label={features.join('. ')}>
        <div class="animate-marquee flex w-max gap-12" aria-hidden="true">
          {[...features, ...features].map((feature, i) => <span data-marquee-duplicate={i >= features.length ? '' : undefined} class="flex items-center gap-12 whitespace-nowrap font-display text-3xl text-muted-foreground">{feature}<span class="bg-sun h-2 w-2 rounded-full"></span></span>)}
        </div>
      </div>

      <section class="relative px-6 py-40 md:py-56" aria-labelledby="speed-title">
        <div class="hairline-grid absolute inset-0" aria-hidden="true"></div>
        <div class="relative mx-auto max-w-5xl text-center">
          <h2 id="speed-title" class="reveal font-display text-[clamp(2.75rem,6vw,5.5rem)] leading-[1]">Good leads go cold.<br /><span class="text-muted-foreground">Fast follow-up</span> <em class="text-sun">keeps them moving.</em></h2>
          <p class="reveal mx-auto mt-10 max-w-xl text-lg text-muted-foreground">You're on a roof, on the road or with a customer. Your follow-up should keep working: answering questions, qualifying homeowners and booking the next step.</p>
        </div>
      </section>

      <section class="px-4" aria-labelledby="leak-title">
        <div class="relative mx-auto max-w-7xl overflow-hidden rounded-[2.5rem] border border-border bg-card px-8 py-20 md:px-16 md:py-28" data-counter-section>
          <div class="sun-orb pointer-events-none absolute -right-32 -top-32 h-[500px] w-[500px] rounded-full opacity-50" aria-hidden="true"></div>
          <div class="relative grid items-end gap-12 md:grid-cols-[1.4fr_1fr]">
            <div>
              <h2 id="leak-title" class="mb-4 text-sm font-normal text-accent">What one missed job can cost</h2>
              <div class="font-display text-sun text-[clamp(4.5rem,13vw,11rem)] leading-[0.85] tabular-nums"><span data-counter aria-hidden="true">$96,000</span><span class="sr-only">$96,000</span></div>
              <p class="mt-6 max-w-md text-lg text-muted-foreground">Miss one $8,000 job each month and that's $96,000 in potential revenue over a year.</p>
              <p class="mt-4 text-xs text-muted-foreground">Illustrative calculation: $8,000 × 12 months.</p>
            </div>
            <div class="space-y-4">{objections.map(([label, description]) => <div class="flex items-baseline justify-between gap-4 border-b border-border pb-4"><span class="font-medium">{label}</span><span class="text-right text-sm text-muted-foreground">{description}</span></div>)}</div>
          </div>
        </div>
      </section>

      <section id="system" class="mx-auto max-w-7xl px-6 py-40" aria-labelledby="system-title">
        <div class="mb-16 flex flex-col justify-between gap-6 md:flex-row md:items-end">
          <h2 id="system-title" class="reveal font-display max-w-2xl text-[clamp(2.75rem,6vw,5.5rem)] leading-[0.95]">From first click. <em class="text-muted-foreground">To booked assessment.</em></h2>
          <p class="reveal max-w-xs text-muted-foreground">We set up and manage every step. You focus on the site visit and the sale.</p>
        </div>
        <div class="grid auto-rows-[minmax(260px,auto)] gap-4 md:grid-cols-6">
          <Spot class="md:col-span-4" n="01" title="Reach local homeowners" description="We run targeted ads for your solar and battery services, focused on the areas you cover.">
            <div class="mt-8 flex items-end gap-2" aria-hidden="true">{[30, 45, 38, 60, 52, 75, 68, 90, 84, 100].map(height => <div class="bg-sun flex-1 rounded-t-md opacity-80 transition-all duration-700 group-hover:opacity-100" style={`height:${height}px`}></div>)}</div>
          </Spot>
          <Spot class="md:col-span-2" n="02" title="Qualify the lead" description="Check ownership, location and energy needs before the enquiry reaches your team.">
            <div class="mt-6 flex flex-wrap gap-2 text-xs">{['✓ Owner', '✓ In area', '✓ $600 bill', '✕ Renter'].map(chip => <span class:list={['rounded-full border px-3 py-1', chip.startsWith('✕') ? 'border-border text-muted-foreground line-through' : 'border-success/40 text-success']}>{chip}</span>)}</div>
          </Spot>
          <Spot class="md:col-span-2" n="03" title="Follow up, 24/7" description="Your AI assistant replies in seconds, including evenings and weekends."><div class="font-display text-sun mt-4 text-7xl">0:02</div></Spot>
          <Spot class="md:col-span-2" n="04" title="Capture the details" description="Answer common questions and collect property details and energy bills for your team." />
          <Spot class="md:col-span-2" n="05" title="Book the assessment" description="Qualified homeowners book into your calendar, with reminders to help them show up.">
            <div class="mt-6 grid grid-cols-5 gap-1.5" aria-hidden="true">{Array.from({ length: 10 }, (_, i) => <div class:list={['h-6 rounded-md', [2, 5, 8].includes(i) ? 'bg-sun' : 'bg-muted']}></div>)}</div>
          </Spot>
        </div>
      </section>

      <div id="compare">
        <section id="race" class="px-6 py-32" aria-labelledby="race-title">
          <div class="mx-auto max-w-6xl">
            <h2 id="race-title" class="reveal font-display text-center text-[clamp(2.75rem,6vw,5.5rem)] leading-[0.95]">Same lead. <em class="text-sun">Two outcomes.</em></h2>
            <div class="mt-20 space-y-10" data-race>
              {race.map(row => <div>
                <div class="mb-3 flex items-baseline justify-between gap-4"><span class="font-medium">{row.who}</span><span class:list={['font-display shrink-0 text-4xl', row.bad ? 'text-muted-foreground' : 'text-sun']}>{row.time}</span></div>
                <div class="h-3 overflow-hidden rounded-full bg-muted" aria-hidden="true"><div class:list={['race-bar h-full rounded-full', row.bad ? 'bg-muted-foreground/40' : 'bg-sun shadow-glow']} style={`--race-width:${row.width};--race-duration:${row.duration}`}></div></div>
                <p class:list={['mt-3 text-sm', row.bad ? 'text-destructive' : 'text-success']}>{row.end}</p>
              </div>)}
            </div>
            <p class="mt-8 text-center text-xs text-muted-foreground">Illustrative comparison. Conversations and timings are examples.</p>
            <p class="reveal mx-auto mt-20 max-w-2xl text-center text-xl text-muted-foreground">Every enquiry needs a next step. <span class="text-foreground">We help yours become an appointment.</span></p>
          </div>
        </section>
      </div>

      <section id="faq" class="mx-auto grid max-w-6xl gap-12 px-6 py-32 md:grid-cols-[1fr_1.5fr]" aria-labelledby="faq-title">
        <h2 id="faq-title" class="reveal font-display text-6xl leading-[0.95]">Questions,<br /><em class="text-muted-foreground">answered.</em></h2>
        <div data-faq>
          {faqs.map((faq, i) => <div class="border-b border-border">
            <button id={`question-${i}`} type="button" data-faq-button aria-expanded="true" aria-controls={`answer-${i}`} class="flex w-full items-center justify-between py-6 text-left text-lg">{faq.question}<span class="faq-plus ml-4 flex h-8 w-8 shrink-0 items-center justify-center rounded-full border border-border transition-all duration-500" aria-hidden="true">+</span></button>
            <div id={`answer-${i}`} class="faq-answer" role="region" aria-labelledby={`question-${i}`}><div><p class="text-muted-foreground">{faq.answer}</p></div></div>
          </div>)}
        </div>
      </section>

      <section class="relative overflow-hidden px-6 py-48 text-center" aria-labelledby="cta-title">
        <div class="sun-orb pointer-events-none absolute left-1/2 top-full h-[900px] w-[900px] -translate-x-1/2 -translate-y-1/3 rounded-full" aria-hidden="true"></div>
        <h2 id="cta-title" class="reveal font-display relative mx-auto max-w-5xl text-[clamp(3.5rem,10vw,9rem)] leading-[0.88]">Your next <em class="text-sun">90 days.</em></h2>
        <p class="reveal relative mx-auto mt-8 max-w-md text-lg text-muted-foreground">Book a strategy call. We'll look at your ads, follow-up and booking process, then map out the next steps for your business.</p>
        <div class="reveal relative mt-12"><BookButton /></div>
      </section>
    </main>
    <footer class="flex flex-col items-center justify-between gap-3 border-t border-border px-6 py-8 text-xs text-muted-foreground sm:flex-row sm:flex-wrap">
      <div class="flex items-center gap-5"><Brand footer /><span>© {new Date().getFullYear()}</span></div>
      <a href="mailto:flowviagrowth@gmail.com" class="transition-colors hover:text-foreground">flowviagrowth@gmail.com</a>
      <span>Built for Australian solar &amp; battery installers</span>
      <button type="button" data-motion-toggle class="motion-toggle underline underline-offset-4" aria-pressed="false">Pause animations</button>
    </footer>
    <script>
      import '../scripts/landing';
    </script>
  </body>
</html>
